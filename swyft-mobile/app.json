{
  "expo": {
    "name": "Swyft",
    "slug": "swyft-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swyftmobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/swyftmobilelogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2196F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swyftinc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Swyft needs access to your location to find rides near you and track your driver.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Swyft needs access to your location to track your delivery in the background.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBrptwerlWpVYRC3P9hsxm415pTkqIEfME"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.swyft.rideshare",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBrptwerlWpVYRC3P9hsxm415pTkqIEfME"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/swyftmobilelogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2196F3"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Swyft to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Swyft to access your photos for ID verification.",
          "cameraPermission": "Allow Swyft to use your camera for ID verification."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Swyft to access your camera for ID verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97f23673-f3cf-43e6-a768-0fc19f89d9d7"
      },
      "apiUrl": "https://swyft-mobile-app.onrender.com"
    }
  }
}